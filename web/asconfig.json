{
  "targets": {
    "debug": {
      "outFile": "build/colbin.debug.wasm",
      "textFile": "build/colbin.debug.wat",
      "sourceMap": true,
      "debug": true
    },
    "release": {
      "outFile": "build/colbin.wasm",
      "optimizeLevel": 3,
      "shrinkLevel": 2,
      "converge": true,
      "noAssert": false
    }
  },
  "options": {
    "bindings": "raw",
    "exportRuntime": true,
    "runtime": "incremental"
  }
}
